# Arquivo modelo de variáveis de ambiente
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o .env — ele está no .gitignore

# URL base da aplicação sendo testada
BASE_URL=https://quickpizza.grafana.com

# Credenciais de autenticação
USERNAME=seu-usuario
PASSWORD=sua-senha

# Token de API (se aplicável)
API_TOKEN=seu-token-aqui

# Configurações do teste
VUS=10
DURATION=30s
AMBIENTE=staging
